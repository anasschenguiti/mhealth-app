<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/user"
                android:contentDescription="user icon"
                android:layout_marginRight="12dp"/>

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bonjour, Secrétaire"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#020202"/>
        </LinearLayout>




        <LinearLayout
            android:id="@+id/btnPatients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_button_bg"
            android:backgroundTint="#E3F2FD"
            android:layout_marginBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/patients"
                android:contentDescription="patients icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patients"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:textColor="#000000"/>
        </LinearLayout>




        <LinearLayout
            android:id="@+id/btnRendezvous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_button_bg"
            android:backgroundTint="#E8F5E9"
            android:layout_marginBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/rendezvous"
                android:contentDescription="rendezvous icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rendez-vous"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:textColor="#000000"/>
        </LinearLayout>




        <LinearLayout
            android:id="@+id/btnPlanning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_button_bg"
            android:backgroundTint="#FFF3E0"
            android:layout_marginBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/planning"
                android:contentDescription="planning icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Planning Médecins"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:textColor="#000000"/>
        </LinearLayout>




        <LinearLayout
            android:id="@+id/btnMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_button_bg"
            android:backgroundTint="#FCE4EC"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/messages"
                android:contentDescription="messages icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:textColor="#000000"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Déconnexion"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            android:backgroundTint="#B00020"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            app:elevation="2dp" />


    </LinearLayout>
</ScrollView>
