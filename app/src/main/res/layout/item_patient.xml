<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/white_pure"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Photo du patient -->
        <ImageView
            android:id="@+id/patient_photo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:background="@drawable/circle_background"
            android:padding="4dp"
            android:contentDescription="Photo du patient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Nom du patient -->
        <TextView
            android:id="@+id/patient_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jean Dupont"
            android:textColor="@color/text_anthracite"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="@id/patient_photo"
            app:layout_constraintStart_toEndOf="@id/patient_photo"
            app:layout_constraintEnd_toStartOf="@id/status_badge" />

        <!-- Âge du patient -->
        <TextView
            android:id="@+id/patient_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45 ans"
            android:textColor="@color/text_gray_medium"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/patient_name"
            app:layout_constraintStart_toEndOf="@id/patient_photo" />

        <!-- Pastille de statut (Urgent/Suivi) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/pastel_salmon"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="@id/patient_name"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgent"
                android:textColor="@color/white_pure"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

