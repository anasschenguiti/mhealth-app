<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_light_blue"
    tools:context=".AddMedicineActivity">

    <!-- En-tête avec titre -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:background="@color/primary_light_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/title_medicine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attribuer un Médicament"
            android:textColor="@color/text_anthracite"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Conteneur blanc aux coins arrondis -->
    <androidx.cardview.widget.CardView
        android:id="@+id/main_content_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="80dp"
        app:cardCornerRadius="30dp"
        app:cardBackgroundColor="@color/white_pure"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Patient -->
                <TextView
                    android:id="@+id/label_patient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient"
                    android:textColor="@color/text_anthracite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <Spinner
                    android:id="@+id/spinner_patient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:minHeight="48dp"
                    android:background="@drawable/edit_text_background"
                    android:spinnerMode="dropdown"
                    app:layout_constraintTop_toBottomOf="@id/label_patient"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Nom du médicament -->
                <TextView
                    android:id="@+id/label_medicine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom du médicament"
                    android:textColor="@color/text_anthracite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/spinner_patient"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_medicine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintTextColor="@color/text_gray_medium"
                    app:boxStrokeColor="@color/pastel_cyan"
                    app:layout_constraintTop_toBottomOf="@id/label_medicine"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_medicine_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nom du médicament"
                        android:textColor="@color/text_anthracite"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Dosage -->
                <TextView
                    android:id="@+id/label_dosage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dosage"
                    android:textColor="@color/text_anthracite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/input_layout_medicine"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_dosage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintTextColor="@color/text_gray_medium"
                    app:boxStrokeColor="@color/pastel_cyan"
                    app:layout_constraintTop_toBottomOf="@id/label_dosage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_dosage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Dosage (ex: 500mg)"
                        android:textColor="@color/text_anthracite"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Fréquence -->
                <TextView
                    android:id="@+id/label_frequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fréquence"
                    android:textColor="@color/text_anthracite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/input_layout_dosage"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_frequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintTextColor="@color/text_gray_medium"
                    app:boxStrokeColor="@color/pastel_cyan"
                    app:layout_constraintTop_toBottomOf="@id/label_frequency"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_frequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Fréquence (ex: 3 fois par jour)"
                        android:textColor="@color/text_anthracite"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Durée -->
                <TextView
                    android:id="@+id/label_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Durée"
                    android:textColor="@color/text_anthracite"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/input_layout_frequency"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintTextColor="@color/text_gray_medium"
                    app:boxStrokeColor="@color/pastel_cyan"
                    app:layout_constraintTop_toBottomOf="@id/label_duration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Durée (ex: 7 jours)"
                        android:textColor="@color/text_anthracite"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Bouton Enregistrer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_medicine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enregistrer"
                    android:textColor="@color/white_pure"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/pastel_cyan"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_marginTop="32dp"
                    app:cornerRadius="25dp"
                    app:layout_constraintTop_toBottomOf="@id/input_layout_duration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
